<?xml version="1.0" encoding="UTF-8"?>
<includes>

	<include name="FullscreenWallpaper">
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1280</width>
			<height>720</height>
			<texture background="true">special://skin/media/AnimeCats/</texture>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1280</width>
			<height>720</height>
			<texture>special://skin/media/vignette.png</texture>
		</control>
	</include>

	<include name="HeaderBar">
		<param name="title" />
		<control type="image">
			<left>0</left>
			<top>0</top>
			<right>0</right>
			<height>58</height>
			<texture colordiffuse="header_fill">special://skin/media/solid.png</texture>
		</control>
		<control type="image">
			<left>0</left>
			<top>54</top>
			<right>0</right>
			<height>4</height>
			<texture colordiffuse="accent">special://skin/media/solid.png</texture>
		</control>
		<control type="label">
			<left>40</left>
			<top>0</top>
			<width>820</width>
			<height>58</height>
			<label>$PARAM[title]</label>
			<font>font_large</font>
			<textcolor>text_primary</textcolor>
			<aligny>center</aligny>
		</control>
		<control type="label">
			<right>40</right>
			<top>0</top>
			<width>360</width>
			<height>58</height>
			<label>$INFO[System.Date]  $INFO[System.Time]</label>
			<font>font_medium</font>
			<textcolor>text_secondary</textcolor>
			<align>right</align>
			<aligny>center</aligny>
		</control>
	</include>

	<include name="BackHint">
		<control type="label">
			<left>40</left>
			<bottom>22</bottom>
			<width>900</width>
			<height>34</height>
			<label>Back - Close</label>
			<font>font_small</font>
			<textcolor>text_secondary</textcolor>
		</control>
		<control type="label">
			<right>40</right>
			<bottom>22</bottom>
			<width>240</width>
			<height>34</height>
			<label>$INFO[Container(50).NumItems] items</label>
			<font>font_small</font>
			<textcolor>text_secondary</textcolor>
			<align>right</align>
		</control>
	</include>

	<include name="FocusHighlight">
		<control type="image">
			<left>0</left>
			<top>4</top>
			<right>8</right>
			<bottom>4</bottom>
			<texture colordiffuse="accent_dim">special://skin/media/focus.png</texture>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>5</width>
			<height>100%</height>
			<texture colordiffuse="accent">special://skin/media/solid.png</texture>
		</control>
	</include>

	<include name="ItemLayoutPanel">
		<param name="w" value="132" />
		<param name="ph" value="192" />
		<param name="h" value="228" />
		<control type="image">
			<left>2</left>
			<top>2</top>
			<width>$PARAM[w]</width>
			<height>$PARAM[ph]</height>
			<texture background="true">$INFO[ListItem.Thumb]</texture>
			<fallback>special://skin/media/logo.png</fallback>
			<aspectratio>stretch</aspectratio>
		</control>
		<control type="label">
			<left>2</left>
			<top>$PARAM[ph]</top>
			<width>$PARAM[w]</width>
			<height>28</height>
			<label>$INFO[ListItem.Label]</label>
			<font>font_small</font>
			<textcolor>text_secondary</textcolor>
			<align>center</align>
		</control>
	</include>

	<include name="ItemLayoutPanelFocused">
		<param name="w" value="132" />
		<param name="ph" value="192" />
		<param name="h" value="228" />
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>$PARAM[w]</width>
			<height>$PARAM[ph]</height>
			<texture colordiffuse="accent_dim">special://skin/media/panel.png</texture>
			<border>4</border>
		</control>
		<control type="image">
			<left>4</left>
			<top>4</top>
			<width>124</width>
			<height>$PARAM[ph]</height>
			<texture background="true">$INFO[ListItem.Thumb]</texture>
			<fallback>special://skin/media/logo.png</fallback>
			<aspectratio>stretch</aspectratio>
		</control>
		<control type="image">
			<left>4</left>
			<top>4</top>
			<width>124</width>
			<height>$PARAM[ph]</height>
			<texture colordiffuse="accent_dim">special://skin/media/vignette.png</texture>
		</control>
		<control type="label">
			<left>2</left>
			<top>$PARAM[ph]</top>
			<width>$PARAM[w]</width>
			<height>28</height>
			<label>$INFO[ListItem.Label]</label>
			<font>font_small</font>
			<textcolor>text_primary</textcolor>
			<align>center</align>
		</control>
		<control type="label">
			<left>8</left>
			<top>$PARAM[ph]</top>
			<width>116</width>
			<height>22</height>
			<label>$INFO[ListItem.Year]</label>
			<font>font_small</font>
			<textcolor>text_secondary</textcolor>
			<align>center</align>
		</control>
	</include>

	<include name="ItemLayoutList">
		<param name="h" />
		<control type="label">
			<left>24</left>
			<top>0</top>
			<width>900</width>
			<height>54</height>
			<label>$INFO[ListItem.Label]</label>
			<font>font_medium</font>
			<textcolor>text_secondary</textcolor>
			<aligny>center</aligny>
		</control>
		<control type="label">
			<right>24</right>
			<top>0</top>
			<width>200</width>
			<height>54</height>
			<label>$INFO[ListItem.Year]</label>
			<font>font_small</font>
			<textcolor>text_secondary</textcolor>
			<align>right</align>
			<aligny>center</aligny>
		</control>
	</include>

	<include name="ItemLayoutListFocused">
		<control type="image">
			<left>0</left>
			<top>3</top>
			<right>10</right>
			<bottom>3</bottom>
			<texture colordiffuse="accent_dim">special://skin/media/focus.png</texture>
		</control>
		<control type="label">
			<left>32</left>
			<top>0</top>
			<width>892</width>
			<height>54</height>
			<label>$INFO[ListItem.Label]</label>
			<font>font_medium</font>
			<textcolor>text_primary</textcolor>
			<aligny>center</aligny>
		</control>
		<control type="label">
			<right>32</right>
			<top>0</top>
			<width>192</width>
			<height>54</height>
			<label>$INFO[ListItem.Year]</label>
			<font>font_small</font>
			<textcolor>text_secondary</textcolor>
			<align>right</align>
			<aligny>center</aligny>
		</control>
	</include>

	<include name="ContentScrollbar">
		<control type="scrollbar" id="60">
			<right>20</right>
			<top>130</top>
			<bottom>150</bottom>
			<width>10</width>
			<orientation>vertical</orientation>
			<texturesliderbackground colordiffuse="scrollbarbg">special://skin/media/solid.png</texturesliderbackground>
			<texturesliderbar colordiffuse="scrollbar">special://skin/media/solid.png</texturesliderbar>
			<texturesliderbarfocus colordiffuse="accent">special://skin/media/solid.png</texturesliderbarfocus>
			<onleft>51</onleft>
			<onright>51</onright>
		</control>
	</include>

	<include name="ButtonFocus">
		<control type="image">
			<left>0</left>
			<top>0</top>
			<right>0</right>
			<bottom>0</bottom>
			<texture colordiffuse="accent">special://skin/media/button_focus.png</texture>
			<border>6</border>
		</control>
	</include>

	<include name="ButtonNoFocus">
		<control type="image">
			<left>0</left>
			<top>0</top>
			<right>0</right>
			<bottom>0</bottom>
			<texture>special://skin/media/button_nofocus.png</texture>
			<border>6</border>
		</control>
	</include>

	<include name="CloseButton">
		<control type="image">
			<right>28</right>
			<top>70</top>
			<width>32</width>
			<height>32</height>
			<texture>special://skin/media/close.png</texture>
		</control>
	</include>

</includes>
