<?xml version="1.0" encoding="UTF-8"?>
<window id="15000">
	<defaultcontrol>50</defaultcontrol>
	<controls>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1280</width>
			<height>720</height>
			<texture colordiffuse="EE000000">special://skin/media/solid.png</texture>
		</control>
		<control type="group">
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>560</width>
			<height>480</height>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<texture colordiffuse="panel_fill_dark">special://skin/media/panel_dark.png</texture>
				<border>14</border>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<height>3</height>
				<texture colordiffuse="accent">special://skin/media/solid.png</texture>
			</control>
			<control type="label">
				<left>30</left>
				<top>20</top>
				<width>500</width>
				<height>40</height>
				<label>Nebula Themes</label>
				<font>font_title</font>
				<textcolor>text_primary</textcolor>
			</control>
			<control type="list" id="50">
				<left>30</left>
				<top>80</top>
				<width>500</width>
				<height>330</height>
				<onup>50</onup>
				<ondown>50</ondown>
				<itemlayout>
					<control type="label">
						<left>20</left>
						<top>0</top>
						<width>460</width>
						<height>50</height>
						<label>$INFO[ListItem.Label]</label>
						<font>font_large</font>
						<textcolor>text_secondary</textcolor>
						<aligny>center</aligny>
					</control>
				</itemlayout>
				<focusedlayout>
					<include>FocusHighlight</include>
					<control type="label">
						<left>36</left>
						<top>0</top>
						<width>444</width>
						<height>50</height>
						<label>$INFO[ListItem.Label]</label>
						<font>font_large</font>
						<textcolor>text_primary</textcolor>
						<aligny>center</aligny>
					</control>
				</focusedlayout>
				<item>
					<label>Midnight</label>
					<onclick>Skin.SetTheme(Midnight)</onclick>
				</item>
				<item>
					<label>Crimson</label>
					<onclick>Skin.SetTheme(Crimson)</onclick>
				</item>
				<item>
					<label>Ocean</label>
					<onclick>Skin.SetTheme(Ocean)</onclick>
				</item>
				<item>
					<label>Ember</label>
					<onclick>Skin.SetTheme(Ember)</onclick>
				</item>
				<item>
					<label>Emerald</label>
					<onclick>Skin.SetTheme(Emerald)</onclick>
				</item>
				<item>
					<label>Violet</label>
					<onclick>Skin.SetTheme(Violet)</onclick>
				</item>
			</control>
			<control type="button" id="300">
				<left>30</left>
				<bottom>24</bottom>
				<width>200</width>
				<height>44</height>
				<label>Close</label>
				<font>font_medium</font>
				<textcolor>text_primary</textcolor>
				<texturefocus colordiffuse="accent">special://skin/media/button_focus.png</texturefocus>
				<texturenofocus>special://skin/media/button_nofocus.png</texturenofocus>
				<onclick>PreviousWindow</onclick>
			</control>
		</control>
	</controls>
</window>
