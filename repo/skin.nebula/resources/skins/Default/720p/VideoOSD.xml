<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol>300</defaultcontrol>
	<controls>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1280</width>
			<height>720</height>
			<texture colordiffuse="99000000">special://skin/media/solid.png</texture>
		</control>

		<control type="image">
			<left>0</left>
			<top>0</top>
			<right>0</right>
			<height>4</height>
			<texture colordiffuse="accent">special://skin/media/solid.png</texture>
		</control>
		<control type="image">
			<left>40</left>
			<top>26</top>
			<width>120</width>
			<height>120</height>
			<texture background="true">$INFO[VideoPlayer.Art(poster)]</texture>
			<fallback>special://skin/media/logo.png</fallback>
			<aspectratio>keep</aspectratio>
		</control>
		<control type="label">
			<left>180</left>
			<top>32</top>
			<width>900</width>
			<height>40</height>
			<label>$INFO[VideoPlayer.Title]</label>
			<font>font_xlarge</font>
			<textcolor>text_primary</textcolor>
			<scroll>true</scroll>
		</control>
		<control type="label">
			<left>182</left>
			<top>78</top>
			<width>900</width>
			<height>28</height>
			<label>$INFO[VideoPlayer.Season]x$INFO[VideoPlayer.Episode]  $INFO[VideoPlayer.Genre]</label>
			<font>font_small</font>
			<textcolor>text_secondary</textcolor>
		</control>
		<control type="label">
			<left>182</left>
			<top>106</top>
			<width>900</width>
			<height>28</height>
			<label>$INFO[VideoPlayer.VideoResolution]p  $INFO[VideoPlayer.VideoCodec]  $INFO[VideoPlayer.AudioCodec]</label>
			<font>font_small</font>
			<textcolor>text_secondary</textcolor>
		</control>

		<control type="group">
			<left>240</left>
			<bottom>34</bottom>
			<width>800</width>
			<height>74</height>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<texture colordiffuse="panel_fill_dark">special://skin/media/panel_dark.png</texture>
				<border>10</border>
			</control>
			<control type="label">
				<left>20</left>
				<top>8</top>
				<width>200</width>
				<height>26</height>
				<label>$INFO[Player.Time]</label>
				<font>font_medium</font>
				<textcolor>text_primary</textcolor>
			</control>
			<control type="label">
				<right>20</right>
				<top>8</top>
				<width>200</width>
				<height>26</height>
				<label>$INFO[Player.Duration]</label>
				<font>font_medium</font>
				<textcolor>text_secondary</textcolor>
				<align>right</align>
			</control>
			<control type="progress" id="44">
				<left>20</left>
				<top>38</top>
				<right>20</right>
				<height>8</height>
				<texturebg colordiffuse="scrollbarbg">special://skin/media/solid.png</texturebg>
				<lefttexture colordiffuse="accent">special://skin/media/solid.png</lefttexture>
				<midtexture colordiffuse="accent">special://skin/media/solid.png</midtexture>
				<righttexture colordiffuse="accent">special://skin/media/solid.png</righttexture>
			</control>
		</control>

		<control type="group">
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>640</width>
			<height>74</height>
			<onleft>300</onleft>
			<onright>300</onright>
			<onup>300</onup>
			<ondown>300</ondown>
			<control type="button" id="300">
				<left>0</left>
				<top>0</top>
				<width>120</width>
				<height>74</height>
				<label>Play/Pause</label>
				<font>font_medium</font>
				<textcolor>text_primary</textcolor>
				<textcolorfocus>text_primary</textcolorfocus>
				<texturefocus colordiffuse="accent">special://skin/media/button_focus.png</texturefocus>
				<texturenofocus>special://skin/media/button_nofocus.png</texturenofocus>
				<onclick>PlayerControl(PlayPause)</onclick>
			</control>
			<control type="button" id="301">
				<left>120</left>
				<top>0</top>
				<width>100</width>
				<height>74</height>
				<label>Rewind</label>
				<font>font_medium</font>
				<textcolor>text_primary</textcolor>
				<texturefocus colordiffuse="accent">special://skin/media/button_focus.png</texturefocus>
				<texturenofocus>special://skin/media/button_nofocus.png</texturenofocus>
				<onclick>PlayerControl(Rewind)</onclick>
			</control>
			<control type="button" id="302">
				<left>220</left>
				<top>0</top>
				<width>100</width>
				<height>74</height>
				<label>Forward</label>
				<font>font_medium</font>
				<textcolor>text_primary</textcolor>
				<texturefocus colordiffuse="accent">special://skin/media/button_focus.png</texturefocus>
				<texturenofocus>special://skin/media/button_nofocus.png</texturenofocus>
				<onclick>PlayerControl(Forward)</onclick>
			</control>
			<control type="button" id="303">
				<left>320</left>
				<top>0</top>
				<width>120</width>
				<height>74</height>
				<label>Previous</label>
				<font>font_medium</font>
				<textcolor>text_primary</textcolor>
				<texturefocus colordiffuse="accent">special://skin/media/button_focus.png</texturefocus>
				<texturenofocus>special://skin/media/button_nofocus.png</texturenofocus>
				<onclick>PlayerControl(Previous)</onclick>
			</control>
			<control type="button" id="304">
				<left>440</left>
				<top>0</top>
				<width>100</width>
				<height>74</height>
				<label>Next</label>
				<font>font_medium</font>
				<textcolor>text_primary</textcolor>
				<texturefocus colordiffuse="accent">special://skin/media/button_focus.png</texturefocus>
				<texturenofocus>special://skin/media/button_nofocus.png</texturenofocus>
				<onclick>PlayerControl(Next)</onclick>
			</control>
			<control type="button" id="305">
				<left>540</left>
				<top>0</top>
				<width>100</width>
				<height>74</height>
				<label>Stop</label>
				<font>font_medium</font>
				<textcolor>text_primary</textcolor>
				<texturefocus colordiffuse="accent">special://skin/media/button_focus.png</texturefocus>
				<texturenofocus>special://skin/media/button_nofocus.png</texturenofocus>
				<onclick>PlayerControl(Stop)</onclick>
			</control>
		</control>
	</controls>
</window>
