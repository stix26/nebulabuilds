<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="plugin.program.nebulawizard" version="1.0.1" name="Nebula Wizard" provider-name="Nebula Builds">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <summary lang="en_gb">One-tap builds and rebuilds for Nebula</summary>
        <description lang="en_gb">Installs Nebula Builds packages: addons, skin and theme in one tap. Handles builds from a hosted repository or a local file.</description>
        <assets>
            <icon>resources/media/logo.png</icon>
            <fanart>resources/media/notify_bg.png</fanart>
        </assets>
    </extension>
</addon>
<addon id="repository.nebulabuilds" version="1.0.2" name="Nebula Builds Repository" provider-name="Nebula Builds">
    <extension point="xbmc.addon.repository">
        <dir>
            <info compressed="false">https://raw.githubusercontent.com/stix26/nebulabuilds/main/hosted/repo/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/stix26/nebulabuilds/main/hosted/repo/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/stix26/nebulabuilds/main/hosted/repo/zips</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <summary lang="en_gb">Nebula Builds add-on repository</summary>
        <description lang="en_gb">Repository for the Nebula skin and Nebula Wizard. Point the URL in repository.nebulabuilds at your hosted copy of the hosted/repo folder.</description>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.png</fanart>
        </assets>
    </extension>
</addon>
<addon id="skin.nebula" version="1.0.0" name="Nebula" provider-name="Nebula Builds">
    <requires>
        <import addon="xbmc.gui" version="5.14.0"/>
    </requires>
    <extension point="xbmc.gui.skin" gui-artwork-dir="media" />
    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <summary lang="en_gb">Nebula - a minimal cinematic skin</summary>
        <description lang="en_gb">A dark, focused skin with six color themes (Midnight, Crimson, Ocean, Ember, Emerald, Violet) for Kodi 20-22. Pairs with the Nebula Builds wizard for one-tap builds and rebuilds.</description>
        <assets>
            <icon>resources/skins/Default/media/icon.png</icon>
            <fanart>resources/skins/Default/media/fanart.png</fanart>
        </assets>
    </extension>
</addon>
</addons>
